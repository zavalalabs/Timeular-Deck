{
	"Name": "EARLY Deck",
	"Version": "0.1.0.0",
	"Author": "Chris",
	"PropertyInspectorPath": "ui/credentials.html",
	"Actions": [
		{
			"Name": "Start Activity",
			"UUID": "com.zavalalabs.early-deck.start-activity",
			"Icon": "imgs/actions/start-activity/icon",
			"Tooltip": "Starts tracking a specific EARLY (Timeular) activity.",
			"PropertyInspectorPath": "ui/activity-picker.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/start-activity/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Stop Tracking",
			"UUID": "com.zavalalabs.early-deck.stop-tracking",
			"Icon": "imgs/actions/stop-tracking/icon",
			"Tooltip": "Stops whatever EARLY activity is currently being tracked.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/stop-tracking/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Toggle Activity",
			"UUID": "com.zavalalabs.early-deck.toggle-activity",
			"Icon": "imgs/actions/toggle-activity/icon",
			"Tooltip": "Starts or stops tracking a specific EARLY activity, and shows whether it's running.",
			"PropertyInspectorPath": "ui/activity-picker.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/toggle-activity/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Current Activity",
			"UUID": "com.zavalalabs.early-deck.current-activity",
			"Icon": "imgs/actions/current-activity/icon",
			"Tooltip": "Displays whichever EARLY activity is currently being tracked.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/current-activity/key",
					"TitleAlignment": "middle"
				}
			]
		}
	],
	"Category": "EARLY Deck",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Track time in EARLY (Timeular) from your Stream Deck or OpenDeck.",
